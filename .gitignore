# ===== 本地隐私数据：绝不入库 =====
# 真实持仓 / 关注库 / 送达配置（含金额、券商、邮箱）
/config/*.md
/config/*.json
!/config/*.example.md
!/config/*.example.json

# 每日报告与证据（含成本、账户、历史 HTML）
/data/

# 历史归档与迁移包
/.archive/

# WorkBuddy 本地工作数据（会话/记忆，非项目资产）
/.workbuddy/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ===== 本地临时 =====
*.local.json
*.log
