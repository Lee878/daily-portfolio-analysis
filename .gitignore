# ===== 本地隐私数据：绝不入库 =====
# 真实持仓 / 关注库 / 送达配置（含金额、券商、邮箱）
/config/*.md
/config/*.json
!/config/*.example.md
!/config/*.example.json
# 持仓更新脚本的本地备份目录（含真实持仓快照，绝不入库）
/config/.holdings-backup/

# 每日报告与证据（含成本、账户、历史 HTML）
/data/

# 历史归档与迁移包
/.archive/

# WorkBuddy 本地工作数据（会话/记忆，非项目资产）
/.workbuddy/

# ===== 含真实持仓的预览产物：绝不入库 =====
# 预览 HTML 与截图内嵌真实成本 / 市值 / 盈亏金额，
# 文本可扫、PNG 二进制无法扫，只能整体排除。
/docs/ui-preview/*.html
/docs/ui-preview/*.png

# ===== 备份文件：绝不入库 =====
# *.bak 会被 git check-ignore 命中，但历史上已被跟踪过，须显式排除
*.bak

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ===== 本地临时 =====
# 一次性取证/构建/验证脚本目录（顶层 tmp-*）：含中间数据与真实持仓快照，绝不入库
/tmp-*/
*.local.json
*.log

# ===== 构建/发布产物：绝不入库 =====
# skill-studio 为本地构建与发布用的中间产物，不属于运行时包，公开仓不含。
/skill-studio/
